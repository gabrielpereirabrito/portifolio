# ═══════════════════════════════════════════════════════════════════
# Variáveis de ambiente — copie para .env e preencha (ADR-0014)
#
# REGRA DE SEGURANÇA: no Vite, só variáveis com o prefixo VITE_ entram no
# bundle e ficam visíveis para qualquer visitante. Nunca dê o prefixo
# VITE_ a chave ou segredo.
# ═══════════════════════════════════════════════════════════════════

# ── Exposto ao navegador ────────────────────────────────────────────
# O cloud_name é público por natureza: aparece em toda URL de entrega.
VITE_CLOUDINARY_CLOUD_NAME=seu-cloud-name

# Chave de acesso do Web3Forms (ADR-0021). É pública por design: o
# serviço a usa para identificar o formulário, não para autenticar.
# Sem ela, o formulário renderiza mas o envio falha — e o erro mostra o
# e-mail direto, que é o plano B previsto no ADR.
VITE_WEB3FORMS_KEY=

# ── Apenas local, para upload via linha de comando ──────────────────
# Nunca chegam ao navegador. CLOUDINARY_URL contém o segredo embutido no
# formato cloudinary://<key>:<secret>@<cloud>.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=/portifolio
